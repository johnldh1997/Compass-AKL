EXPO_PUBLIC_AT_API_KEY=
# The Google *Maps key*: restricted to Maps SDK for Android only, and baked into the build for the map. It
# ships inside the app, so it must not be able to do anything else. The Places + Routes key lives in the
# Worker (GOOGLE_API_KEY), never here.
EXPO_PUBLIC_GOOGLE_DIRECTIONS_KEY=
# Base URL of the Worker (see server/): journey planning, place search and Find Nearby all go through it.
# e.g. http://192.168.1.x:8788 for local dev, or the deployed Worker URL.
EXPO_PUBLIC_NEARBY_PROXY_URL=
